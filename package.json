    "codemirror": "^6.0.1",
    "cron-parser": "^4.9.0",
    "dayjs": "^1.11.13",
    "diff": "^7.0.0",
    "dompurify": "^3.2.6",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.11.1",
    "js-md5": "^0.9.2",
    "js-yaml": "^5.4.2",
    "lucide-vue-next": "^0.468.0",
    "marked": "^15.0.6",
    "papaparse": "^5.7.0",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.8.0",
    "sql-formatter": "^15.4.6",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.13",
