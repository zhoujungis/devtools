    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.68.0",
